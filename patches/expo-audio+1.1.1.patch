+package expo.modules.audio.service
+
+import android.util.Log
+import androidx.annotation.OptIn
+import androidx.media3.common.ForwardingPlayer
+import androidx.media3.common.Player
+import androidx.media3.common.util.UnstableApi
+import kotlin.math.abs
+
+/**
+ * Lock screen / notif : prev/next de file (pas seek ±10 s).
+ *
+ * One UI / Media3 :
+ * - avec 1 seul MediaItem, ExoPlayer retire NEXT/PREV → UI podcast (±10 s)
+ * - on force COMMAND_SEEK_TO_NEXT/PREVIOUS (+ MEDIA_ITEM) en permanence
+ * - on réécrit onAvailableCommandsChanged (sinon MediaSession re-strip)
+ * - hasNext/PreviousMediaItem = true pour forcer les flèches titre
+ */
+@OptIn(UnstableApi::class)
+class SeekAsSkipPlayer(player: Player) : ForwardingPlayer(player) {
+  companion object {
+    private const val TAG = "HimbaAudioSession"
+  }
+
+  private val wrappedListeners =
+    java.util.Collections.synchronizedMap(mutableMapOf<Player.Listener, Player.Listener>())
+
+  override fun seekForward() {
+    Log.d(TAG, "seekForward intercepted -> NEXT_TRACK")
+    AudioControlsService.emitRemoteSkipNext()
+  }
+
+  override fun seekBack() {
+    Log.d(TAG, "seekBack intercepted -> PREVIOUS_TRACK")
+    AudioControlsService.emitRemoteSkipPrevious()
+  }
+
+  override fun seekToNext() {
+    Log.d(TAG, "seekToNext -> NEXT_TRACK")
+    AudioControlsService.emitRemoteSkipNext()
+  }
+
+  override fun seekToPrevious() {
+    Log.d(TAG, "seekToPrevious -> PREVIOUS_TRACK")
+    AudioControlsService.emitRemoteSkipPrevious()
+  }
+
+  override fun seekToNextMediaItem() {
+    Log.d(TAG, "seekToNextMediaItem -> NEXT_TRACK")
+    AudioControlsService.emitRemoteSkipNext()
+  }
+
+  override fun seekToPreviousMediaItem() {
+    Log.d(TAG, "seekToPreviousMediaItem -> PREVIOUS_TRACK")
+    AudioControlsService.emitRemoteSkipPrevious()
+  }
+
+  override fun seekTo(positionMs: Long) {
+    val current = currentPosition
+    val delta = positionMs - current
+    if (isButtonJump(delta, seekForwardIncrement) ||
+      isButtonJump(delta, 10_000L) ||
+      isButtonJump(delta, 15_000L)
+    ) {
+      Log.d(TAG, "seekTo($positionMs) delta=$delta intercepted -> NEXT_TRACK")
+      AudioControlsService.emitRemoteSkipNext()
+      return
+    }
+    if (isButtonJump(-delta, seekBackIncrement) ||
+      isButtonJump(-delta, 10_000L) ||
+      isButtonJump(-delta, 5_000L)
+    ) {
+      Log.d(TAG, "seekTo($positionMs) delta=$delta intercepted -> PREVIOUS_TRACK")
+      AudioControlsService.emitRemoteSkipPrevious()
+      return
+    }
+    if (current in 1..(15_000L) && positionMs < 500L && delta < -400L) {
+      Log.d(TAG, "seekTo($positionMs) near-start rewind intercepted -> PREVIOUS_TRACK")
+      AudioControlsService.emitRemoteSkipPrevious()
+      return
+    }
+    super.seekTo(positionMs)
+  }
+
+  /** Force l’UI musicale même avec une file native d’un seul item. */
+  override fun hasNextMediaItem(): Boolean = true
+
+  override fun hasPreviousMediaItem(): Boolean = true
+
+  override fun getAvailableCommands(): Player.Commands {
+    return withMusicTransport(super.getAvailableCommands())
+  }
+
+  override fun isCommandAvailable(command: Int): Boolean {
+    return when (command) {
+      Player.COMMAND_SEEK_FORWARD,
+      Player.COMMAND_SEEK_BACK,
+      -> false
+      Player.COMMAND_SEEK_TO_NEXT,
+      Player.COMMAND_SEEK_TO_PREVIOUS,
+      Player.COMMAND_SEEK_TO_NEXT_MEDIA_ITEM,
+      Player.COMMAND_SEEK_TO_PREVIOUS_MEDIA_ITEM,
+      -> true
+      else -> super.isCommandAvailable(command)
+    }
+  }
+
+  override fun addListener(listener: Player.Listener) {
+    val wrapped =
+      object : Player.Listener by listener {
+        override fun onAvailableCommandsChanged(availableCommands: Player.Commands) {
+          listener.onAvailableCommandsChanged(withMusicTransport(availableCommands))
+        }
+      }
+    wrappedListeners[listener] = wrapped
+    super.addListener(wrapped)
+  }
+
+  override fun removeListener(listener: Player.Listener) {
+    val wrapped = wrappedListeners.remove(listener) ?: listener
+    super.removeListener(wrapped)
+  }
+
+  private fun withMusicTransport(commands: Player.Commands): Player.Commands {
+    return commands
+      .buildUpon()
+      .remove(Player.COMMAND_SEEK_FORWARD)
+      .remove(Player.COMMAND_SEEK_BACK)
+      .add(Player.COMMAND_SEEK_TO_PREVIOUS)
+      .add(Player.COMMAND_SEEK_TO_NEXT)
+      .add(Player.COMMAND_SEEK_TO_PREVIOUS_MEDIA_ITEM)
+      .add(Player.COMMAND_SEEK_TO_NEXT_MEDIA_ITEM)
+      .build()
+  }
+
+  private fun isButtonJump(signedDelta: Long, jumpMs: Long): Boolean {
+    if (signedDelta <= 0L || jumpMs <= 0L) {
+      return false
+    }
+    return abs(signedDelta - jumpMs) <= 2_500L
+  }
+}
