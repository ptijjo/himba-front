+package expo.modules.audio.service
+
+import androidx.annotation.OptIn
+import androidx.media3.common.ForwardingPlayer
+import androidx.media3.common.Player
+import androidx.media3.common.util.UnstableApi
+
+/**
+ * OEM (Xiaomi / Samsung) appellent souvent seekForward/seekBack (±10 s)
+ * même si on publie des boutons custom prev/next.
+ *
+ * On laisse les commandes SEEK_* disponibles (sinon pas de boutons),
+ * mais on détourne seekForward/seekBack / seek ±10 s → skip file JS.
+ * Le scrub libre (barre) passe encore par seekTo hors fenêtre ±10 s.
+ */
+@OptIn(UnstableApi::class)
+class SeekAsSkipPlayer(player: Player) : ForwardingPlayer(player) {
+
+  override fun seekForward() {
+    AudioControlsService.emitRemoteSkipNext()
+  }
+
+  override fun seekBack() {
+    AudioControlsService.emitRemoteSkipPrevious()
+  }
+
+  override fun seekToNext() {
+    AudioControlsService.emitRemoteSkipNext()
+  }
+
+  override fun seekToPrevious() {
+    AudioControlsService.emitRemoteSkipPrevious()
+  }
+
+  override fun seekToNextMediaItem() {
+    AudioControlsService.emitRemoteSkipNext()
+  }
+
+  override fun seekToPreviousMediaItem() {
+    AudioControlsService.emitRemoteSkipPrevious()
+  }
+
+  override fun seekTo(positionMs: Long) {
+    val current = currentPosition
+    val delta = positionMs - current
+    val jump = AudioControlsService.SEEK_INTERVAL_MS
+    // Bouton système ±10 s (souvent via seekTo(current ± 10000))
+    if (delta in (jump - 2000)..(jump + 2000)) {
+      AudioControlsService.emitRemoteSkipNext()
+      return
+    }
+    if (delta in -(jump + 2000)..-(jump - 2000)) {
+      AudioControlsService.emitRemoteSkipPrevious()
+      return
+    }
+    // Rewind clampé près du début
+    if (current in 1..(jump + 2000) && positionMs < 500L && delta < -400L) {
+      AudioControlsService.emitRemoteSkipPrevious()
+      return
+    }
+    super.seekTo(positionMs)
+  }
+
+  override fun getAvailableCommands(): Player.Commands {
+    // Garder SEEK_BACK/FORWARD visibles pour que l’OEM affiche les boutons
+    // (détournés ci-dessus). Masquer seulement la nav multi-item native.
+    return super.getAvailableCommands()
+      .buildUpon()
+      .remove(Player.COMMAND_SEEK_TO_PREVIOUS_MEDIA_ITEM)
+      .remove(Player.COMMAND_SEEK_TO_NEXT_MEDIA_ITEM)
+      .build()
+  }
+}
