{
  "expo": {
    "name": "Himba",
    "slug": "himba",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/images/Logo.jpg",
    "scheme": "himba",
    "userInterfaceStyle": "dark",
    "owner": "ptijjo",
    "ios": {
      "icon": "./assets/images/Logo.jpg",
      "bundleIdentifier": "fr.cellulenoire.himba",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "fr.cellulenoire.himba",
      "versionCode": 4,
      "adaptiveIcon": {
        "backgroundColor": "#0B0618",
        "foregroundImage": "./assets/images/Logo.jpg"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/Logo.jpg"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0618",
          "image": "./assets/images/Logo.jpg",
          "imageWidth": 120
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-audio",
      [
        "expo-image-picker",
        {
          "photosPermission": "Himba a besoin d’accéder à tes photos pour la photo de profil.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-document-picker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3b64aa6a-1789-4529-a8f6-9231feb5b38f"
      }
    }
  }
}
