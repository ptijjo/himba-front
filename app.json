{
  "expo": {
    "name": "Himba",
    "slug": "himba",
    "version": "1.0.17",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "himba",
    "userInterfaceStyle": "dark",
    "owner": "ptijjo",
    "ios": {
      "icon": "./assets/images/icon-ios.png",
      "bundleIdentifier": "fr.cellulenoire.himba",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "package": "fr.cellulenoire.himba",
      "versionCode": 19,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#0B0618",
        "foregroundImage": "./assets/images/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0618",
          "image": "./assets/images/logo_dans_app.png",
          "imageWidth": 200
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-audio",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/adaptive-icon.png",
          "color": "#E85D04",
          "defaultChannel": "sorties_v2"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Himba a besoin d’accéder à tes photos pour la photo de profil.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-document-picker",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3b64aa6a-1789-4529-a8f6-9231feb5b38f"
      }
    }
  }
}
