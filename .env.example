# Copier vers `.env` en local (jamais committer `.env`).
# Dev : API locale / LAN
EXPO_PUBLIC_API_URL=http://localhost:8989

# Stripe — clé *publishable* uniquement (pk_test_… / pk_live_…).
# Jamais la secret key (sk_…) dans l’app mobile.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_remplacer

# Builds release (EAS / Gradle local) forcent aussi via eas.json / env shell :
# EXPO_PUBLIC_API_URL=https://himba.cellulenoire.fr
# EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_… (ou pk_live_… en prod)
